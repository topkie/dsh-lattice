{
  "name": "dsh-lattice",
  "version": "0.11.0",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "description": "DeepSeek Harness 的本地记忆插件：把值得长期复用的知识写成带主题与关联的条目，之后按语义召回；数据存在本地 SQLite 库里，向量模型首次使用时下载，之后离线可用。",
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" \"lib/**/*.js\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" \"lib/**/*.js\" \".github/**/*.yml\"",
    "test": "node --import ./test/stubs/register.mjs test/run.mjs",
    "check": "node scripts/check-all.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.2 <0.2.0 || >=0.2.0-rc.1 <0.2.1 || >=0.2.1-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.2 <0.2.0 || >=0.2.0-rc.1 <0.2.1 || >=0.2.1-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "marketplace": {
      "profiles": [
        "web",
        "desktop"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": false
    },
    "permissions": {
      "level": "medium",
      "files": "read-write",
      "network": "download-on-first-use",
      "commands": "node",
      "credentials": [],
      "externalServices": [],
      "notes": "Read/write under the lattice data directory only. The only outbound traffic is the one-time model download (about 23 MB) on the first recall, trying huggingface.co first and modelscope.cn second; both can be redirected by encoderMirror. Nothing else leaves the machine."
    },
    "compatibility": {
      "dsh": ">=0.1.5-alpha.2 <0.3.0-0",
      "node": ">=22.13",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "license": "MIT",
  "author": "topkie <topkie@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/topkie/dsh-lattice.git"
  },
  "homepage": "https://github.com/topkie/dsh-lattice#readme",
  "bugs": {
    "url": "https://github.com/topkie/dsh-lattice/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "memory",
    "sqlite",
    "embeddings",
    "rag"
  ],
  "optionalDependencies": {
    "@huggingface/transformers": "^3.0.0"
  }
}
